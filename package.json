{
  "name": "kouyaku-check",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/validate-data.ts",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "check": "astro check && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/validate-data.ts",
    "validate": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/validate-data.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "knip": "knip"
  },
  "dependencies": {
    "astro": "^5.13.7",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "globals": "^17.12.0",
    "knip": "^6.35.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
