---
import BaseLayout from "../layouts/BaseLayout.astro";
import { countLabels, isSittingMember, labelClassName } from "../lib/labels";
import { loadPoliticians } from "../lib/politicians";
import { LABELS } from "../lib/types";

const politicians = loadPoliticians();
---

<BaseLayout title="公約チェック" current="home">
  <section class="hero">
    <h1>公約チェック</h1>
    <p class="lede">
      国会議員の主張と、国会・内閣での行動を短い要約と公式リンクで対照します。ラベルは行動一致・公約実現・ズレ・不明の4つで、足し合わせません。点数化はしません。
    </p>
  </section>

  <section class="about-card" aria-labelledby="scope-heading">
    <h2 id="scope-heading">いま見られる対象</h2>
    <p>
      MVPでは指定した議員のみを掲載します。データはリポジトリの YAML をビルド時に読み込み、データベースは使いません。
    </p>
  </section>

  <ul class="member-list">
    {
      politicians.map((politician) => {
        const counts = countLabels(politician.entries);
        return (
          <li>
            <a class="member-card" href={`/politicians/${politician.id}`}>
              <h2>
                {politician.name}
                {isSittingMember(politician) ? null : <span class="office-badge">非現職 ／ 議席なし</span>}
              </h2>
              <p class="member-meta">
                {isSittingMember(politician) ? `${politician.house} ／ ${politician.party}` : `最終所属：${politician.house} ／ ${politician.party}`}
              </p>
              <div class="mini-counts">
                {
                  LABELS.map((label) => (
                    <span class:list={["label-badge", labelClassName(label)]}>
                      {label} {counts[label]}
                    </span>
                  ))
                }
              </div>
            </a>
          </li>
        );
      })
    }
  </ul>
</BaseLayout>
